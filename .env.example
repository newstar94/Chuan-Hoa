# Server environment only. Never ship these secrets inside the Word add-in.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=https://your-domain.example/billing/return
PayOS__CancelUrl=https://your-domain.example/billing/cancel
# Register /v1/billing/payos/webhook in your payOS merchant dashboard.
ConnectionStrings__ChuanHoa=
# Bidding server-to-server admin handshake. Store the shared secret outside
# this file in production and use the same value on both applications.
ChuanHoa__AdminIntegration__Enabled=false
ChuanHoa__AdminIntegration__ClientId=bidding-admin
ChuanHoa__AdminIntegration__SharedSecret=
ChuanHoa__AdminIntegration__ClockSkewSeconds=300
# ChuanHoa__AdminIntegration__BaseUrl=https://chuan-hoa-internal.example
# ChuanHoa__AdminDashboardUrl=https://hosodauthau.online/admin/chuan-hoa
# Development dùng bootstrap secret cục bộ khi Bidding gọi loopback 127.0.0.1:5206.
# OIDC provider and production identity/device enrollment remain required.
Authentication__Authority=
Authentication__Audience=
