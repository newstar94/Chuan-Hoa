  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="GenerateProductVersionAssemblyInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ProductVersionAssemblyInfo Include="[assembly: System.Reflection.AssemblyVersionAttribute(&quot;$(ProductVersion)&quot;)]" />
      <_ProductVersionAssemblyInfo Include="[assembly: System.Reflection.AssemblyFileVersionAttribute(&quot;$(ProductVersion)&quot;)]" />
      <_ProductVersionAssemblyInfo Include="[assembly: System.Reflection.AssemblyInformationalVersionAttribute(&quot;$(ProductVersion)&quot;)]" />
      <_ProductVersionAssemblyInfo Include="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;ChuanHoa.SigningCertificateSha256&quot;, &quot;$(TrustedSigningCertificateSha256)&quot;)]" />
      <_ProductVersionAssemblyInfo Include="[assembly: System.Runtime.CompilerServices.InternalsVisibleToAttribute(&quot;ChuanHoa.AnnotationSmoke&quot;)]" />
      <_ProductVersionAssemblyInfo Include="[assembly: System.Runtime.CompilerServices.InternalsVisibleToAttribute(&quot;ChuanHoa.LocalScanSmoke&quot;)]" />
      <Compile Include="$(IntermediateOutputPath)ChuanHoa.ProductVersion.g.cs" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)ChuanHoa.ProductVersion.g.cs"
      Lines="@(_ProductVersionAssemblyInfo)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <Target Name="ValidateUnifiedVersionContract" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ProductVersion)' == ''"
           Text="ProductVersion must be defined by Directory.Build.props." />
    <Error Condition="'$(Version)' != '$(ProductVersion)' or
                      '$(AssemblyVersion)' != '$(ProductVersion)' or
                      '$(FileVersion)' != '$(ProductVersion)' or
                      '$(InformationalVersion)' != '$(ProductVersion)'"
           Text="Version, AssemblyVersion, FileVersion and InformationalVersion must all equal ProductVersion." />
    <Error Condition="'$(ApplicationVersion)' != '$(ProductVersion)'"
           Text="ApplicationVersion cannot differ from ProductVersion. Directory.Build.props is the only release-version source." />
    <Error Condition="'$(Configuration)' == 'Development' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(TrustedSigningCertificateSha256)', '^[0-9A-Fa-f]{64}$'))"
           Text="Development VSTO builds require a 64-character TrustedSigningCertificateSha256 startup pin." />
  </Target>

  <Import Project="$(VSToolsPath)\OfficeTools\Microsoft.VisualStudio.Tools.Office.targets"
          Condition="Exists('$(VSToolsPath)\OfficeTools\Microsoft.VisualStudio.Tools.Office.targets')" />

  <!--
    OfficeTools normally rewrites HKCU\Office\Word\Addins during Build and deletes
    the same registration during Clean/Rebuild. Chuẩn hóa uses an explicit
    development bootstrapper/launcher instead. Keeping all three targets as no-ops
    prevents verification builds from replacing or deleting the installed Current
    manifest and its VSTO inclusion-list trust.
  -->
  <Target Name="RegisterOfficeAddin" />
  <Target Name="UnregisterOfficeAddin" />
  <Target Name="RemoveOfficeAddInSecurity" />

  <Target Name="RequireVstoOfficeTools"
          BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(VSToolsPath)\OfficeTools\Microsoft.VisualStudio.Tools.Office.targets')">
    <Error Text="VSTO Office Developer Tools are required to build ChuanHoa.AddIn.Vsto. Install the Word VSTO workload and .NET Framework 4.8 targeting pack on the build agent." />
  </Target>
</Project>
