Private Function DecodeBase64(ByVal b64 As String) As Byte()
    Dim xmlDoc As Object
    Dim node As Object
    Set xmlDoc = CreateObject("MSXML2.DOMDocument")
    Set node = xmlDoc.createElement("b64")
    node.DataType = "bin.base64"
    node.text = b64
    Dim bytes() As Byte
    bytes = node.nodeTypedValue
    DecodeBase64 = bytes
End Function

' Ghi mang byte ra mot file.bmp tam trong TEMP roi LoadPicture - VBA khong the tao StdPicture
' thang tu mang byte trong bo nho, phai di qua file that tren dia.
Private Function PictureFromBase64(ByVal b64 As String, ByVal tempFileTag As String) As IPictureDisp
    On Error GoTo ErrHandler
    Dim bytes() As Byte
    bytes = DecodeBase64(b64)
    Dim tempPath As String
    tempPath = Environ$("TEMP") & "\ChuanHoaTheThuc-icon-" & tempFileTag & ".bmp"
    Dim fnum As Integer
    fnum = FreeFile
    Open tempPath For Binary Access Write As #fnum
    Put #fnum, 1, bytes
    Close #fnum
    Set PictureFromBase64 = LoadPicture(tempPath)
    Exit Function
ErrHandler:
    DebugTrace.LogErr "CustomIcons.PictureFromBase64", tempFileTag, Err.number, Err.description
    Set PictureFromBase64 = Nothing
End Function

' getImage callback cho nut menu "i / y" (mnuIY, nhom Chinh ta va so) - theo dung chu ky RibbonX:
' Sub GetImageXxx(control As IRibbonControl, ByRef image).
Public Sub GetImageIY(ByVal Control As IRibbonControl, ByRef image)
    Set image = PictureFromBase64(IYBase64(), "iy")
End Sub
