<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Development</Configuration>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <RootNamespace>ChuanHoa.DevelopmentAccessSmoke</RootNamespace>
    <AssemblyName>ChuanHoa.DevelopmentAccessSmoke</AssemblyName>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="ChuanHoa.Client.Core">
      <HintPath>..\..\..\src\ChuanHoa.Client.Core\bin\$(Configuration)\netstandard2.0\ChuanHoa.Client.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ChuanHoa.AddIn.Vsto">
      <HintPath>..\..\..\src\ChuanHoa.AddIn.Vsto\bin\$(Configuration)\ChuanHoa.AddIn.Vsto.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup><Compile Include="Program.cs" /></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
